# =============================================================================
# PÉLDA a .env fájlhoz — MÁSOLD LE .env néven és töltsd ki
#
#     Copy-Item .env.example .env
#
# EBBEN A FÁJLBAN CSAK A KULCSOK NEVE VAN, ÉRTÉK SOHA.
# A .env a .gitignore-ban van, és soha nem kerülhet a repóba.
#
# A repó PUBLIKUS — egy véletlenül commitolt kulcs azonnal kompromittált,
# és a GitHub history-ból nem elég törölni, cserélni is kell.
#
# Hogy honnan szerzed be az egyes értékeket: docs/SECRETS.md
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Honnan: Supabase Dashboard → a projekted → Settings → Data API
SUPABASE_URL=

# FIGYELEM: a service role kulcs MEGKERÜLI a row level security-t.
# Csak szerveroldalon (ez a pipeline) és GitHub Secretsben élhet.
# Frontendbe SOHA nem kerülhet — oda az anon kulcs való, RLS mellett.
# Honnan: Supabase Dashboard → Settings → API keys → service_role (Reveal)
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail (Gmail SMTP) ------------------------------------------------------
# A Gmail-címed, amiről a levél megy
EMAIL_FELHASZNALO=

# FIGYELEM: ez NEM a Google-fiók jelszava, hanem külön generált APP-JELSZÓ.
# Ehhez 2FA-nak bekapcsolva kell lennie a fiókon.
# Honnan: https://myaccount.google.com/apppasswords
# 16 karakter, szóközök nélkül írd be.
EMAIL_APP_JELSZO=

# Ide megy a javaslatokat tartalmazó levél (lehet ugyanaz, mint a feladó)
EMAIL_CIMZETT=

# --- Opcionális ---------------------------------------------------------------
# Naplózás formátuma felülírása: konzol | json
# TIPPMIX_NAPLO_FORMATUM=konzol
